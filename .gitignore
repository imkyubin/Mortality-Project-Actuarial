# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Streamlit local secrets
.streamlit/secrets.toml

# Local notes for AI coding assistants (kept on the author's machine only)
CLAUDE.md

# CDC WONDER data is not redistributed: every CSV under data/ (raw exports, processed
# tables) and the Phase 1 prototype's local copies stay on your machine.
# See data/README.md for how to recreate them.
data/**/*.csv
archive/phase1_excel/data/

# ...except data/dashboard/: derived tables only (rates, life-table values, ratios, model
# outputs; no Deaths or Population), committed so the dashboard runs from a fresh clone.
!data/dashboard/*.csv
!data/dashboard/model/*.csv
